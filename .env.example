# Copy to .env (git-ignored) and fill in every value before `docker compose up`.
# Never commit .env.

# Required by docker-compose.yml: the PostgreSQL password, used by the database and the app.
# Left empty on purpose: compose refuses to start until it is set. Use URL-safe characters
# (the app embeds it in AGENTSCOPE_DATABASE_URL), for example the output of
#   python3 -c 'import secrets; print(secrets.token_urlsafe(32))'
POSTGRES_PASSWORD=
